load("@rules_haskell//haskell:defs.bzl", "haskell_library", "haskell_test")

haskell_library(
    name = "tox",
    srcs = glob(["src/**/*.hs"]),
    src_strip_prefix = "src",
    tags = [
        "haskell",
        "no-cross",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//hs-toxav",
        "//hs-toxcore:tox-application",
        "//hs-toxcore:tox-core",
        "//hs-toxcore:tox-crypto",
        "//hs-toxcore:tox-session",
        "//hs-toxsync:toxsync",
        "//third_party/haskell:base",
        "//third_party/haskell:base16-bytestring",
        "//third_party/haskell:binary",
        "//third_party/haskell:bytestring",
        "//third_party/haskell:containers",
        "//third_party/haskell:cryptohash-sha256",
        "//third_party/haskell:directory",
        "//third_party/haskell:filepath",
        "//third_party/haskell:monad-logger",
        "//third_party/haskell:qrcode-core",
        "//third_party/haskell:saltine",
        "//third_party/haskell:text",
        "//third_party/haskell:time",
        "//third_party/haskell:unix",
        "//third_party/haskell:vector",
    ],
)

haskell_test(
    name = "testsuite",
    size = "small",
    srcs = glob(["test/**/*.hs"]),
    main_file = "test/testsuite.hs",
    src_strip_prefix = "test",
    tags = ["haskell"],
    deps = [
        ":tox",
        "//hs-toxcore:tox-application",
        "//hs-toxcore:tox-crypto",
        "//hs-toxcore:tox-network",
        "//hs-toxsync:toxsync",
        "//third_party/haskell:QuickCheck",
        "//third_party/haskell:base",
        "//third_party/haskell:base16-bytestring",
        "//third_party/haskell:binary",
        "//third_party/haskell:bytestring",
        "//third_party/haskell:containers",
        "//third_party/haskell:cryptohash-sha256",
        "//third_party/haskell:directory",
        "//third_party/haskell:filepath",
        "//third_party/haskell:hspec",
        "//third_party/haskell:saltine",
        "//third_party/haskell:text",
        "//third_party/haskell:time",
        "//third_party/haskell:vector",
    ],
)
